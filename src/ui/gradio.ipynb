import gradio as gr 

history = [{"role" : "assistant", "content" : "어서오세요! Hire Me ASAP 입니다.\n취업 분석을 원하시면 이력서를 업로드 해보세요.😀"}, {"role" : "user", "content" : "안녕 나는 평생 직장을 찾고 있어"}]

theme = gr.themes.Soft(
    primary_hue="gray",
    secondary_hue="stone",
    neutral_hue="zinc",
    font=[gr.themes.GoogleFont('Noto Sans Korean '), gr.themes.GoogleFont('42dot Sans'), gr.themes.GoogleFont('Nanum Gothic '), 'sans-serif'],
).set(
    button_transform_hover='*button_primary_background_fill'
)

# CSS 스타일 정의
custom_css = """ 
* {
    font-family: 'NeoDunggeunmo', sans-serif !important;
    font-size: 16px !important;
}

.custom-row {
    display: block;
}

.custom-button {
    margin: 10px;
    padding: 5px 5px;
    height: 40px;
    width : 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.custom-input {    
    align-items: top;     
}

.chatbot-example .example-text {
    text-align: center;
    justify-content: center;
}

input[type="checkbox"] {
    width: 18px;
    height: 18px;
    border: 1px solid #444 !important;
    border-radius: 4px;
    appearance: none;
    -webkit-appearance: none;
    background-color: white;
    cursor: pointer;
    position: relative;
}

input[type="checkbox"]:checked::before {
    position: absolute;
    top: -2px;
    left: 2px;
    font-size: 16px;
    color: #0d0d0d;
}

.example-row {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;

    width: 100%;
    max-width: 800px;
    padding: 15px;
    z-index: 2;
}

.example-btn {
    background-color: #f2f2f2 !important;
    color: #000;
    padding: 14px 24px;
    border-radius: 12px;
    border: 2px solid #f2f2f2;
    font-size: 0.9rem;
    text-align: center;
    transition: all 0.3s ease;
    box-shadow: 2px 2px 6px rgba(0,0,0,0.1); 
    width: 300px;              /* 고정 너비 */
    min-width: 280px;
    max-width: 310px;
    white-space: nowrap;       /* 텍스트 줄바꿈 방지 */
}

.example-btn:hover {
    box-shadow: 2px 2px 6px rgba(0,0,0,0.1); /* 그림자 효과 */
    background-color: #1a1a1a;
    transform: translateY(-3px);
    cursor: pointer;
}

.gr-avatar {
    width: 40px !important;
    height: 40px !important;
    border-radius: 50%;
}

footer { 
    visibility: hidden; 
}
"""


with gr.Blocks(theme=theme, css=custom_css) as demo :
    with gr.Sidebar(open=False) :
        gr.Markdown("프로필")
        gr.Image(value="profile.png", width="200px", show_label=False, show_download_button=False, show_fullscreen_button=False, show_share_button=False)
        gr.Markdown("🔮 무엇이 궁금하신가요?")    
        gr.Button("🔍 인생 회사 찾기", size="sm")
        gr.Button("🎯 나에게 맞는 직무는?", size="sm")
        gr.Button("🔥 내가 보완할 부분은?", size="sm")
        gr.Button("📍 커리어 로드맵 그리기", size="sm")
        gr.Button("📂 대화 내용 저장하기", variant="huggingface", size="sm")
        gr.Markdown("🐚 Who we are?")
        gr.Image(value="cherry.png", width="250px", show_label=False, show_download_button=False, show_fullscreen_button=False, show_share_button=False)
    
    gr.Chatbot(
        height="85vh",
        type='messages',
        container=False,
        avatar_images=("chicken.png", "magicball.jpeg"),
        elem_classes="chatbot-box"
    )

    with gr.Row(elem_classes="example-row"):
        for text in ["취업할만한 회사를 찾고 싶어", "내 커리어 로드맵을 그리고 싶어",
                    "내가 개선할 수 있는 부분을 알려줘", "나에게 잘 맞는 직무를 찾고 싶어"]:
            gr.Button(text, elem_classes="example-btn")
        # placeholder="어서오세요! Hire Me 입니다. 취업 분석을 원하시면 이력서를 업로드 해보세요.😀"
        # examples=[{"text": "취업할만한 회사를 찾고 싶어"}, {"text": "내 커리어 로드맵을 그리고 싶어"}]
    with gr.Row() :
        gr.UploadButton(label="upload", icon="img.png", file_types=["image"], scale=1, elem_classes=["custom-button"])
        with gr.Column(elem_classes=["custom-input"], scale=30) :
            gr.Textbox(placeholder="무엇이든 물어보세요", show_label=False, scale=30)
            gr.Checkbox(label="🪄 관련 강의 추천 받기", elem_classes=["custom-checkbox"])
        gr.Button("🚀", scale=1, size="md", elem_classes=["custom-button"])
    

demo.launch()
